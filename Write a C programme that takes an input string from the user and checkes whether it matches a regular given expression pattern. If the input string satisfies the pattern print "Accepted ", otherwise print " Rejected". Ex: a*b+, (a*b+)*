//Week:5.2 regular expression: a*b+
#include <stdio.h>
#include <string.h>
int main() {
char text[100];
printf("Enter a string: ");
scanf("%s", text);
int i = 0;
while (text[i] == 'a') {
i++;
}
int bCount = 0;
while (text[i] == 'b') {
i++;
bCount++;
}
if (text[i] == '\0' && bCount > 0) {
printf("Accepted\n");
} else {
printf("Rejected\n");
}
return 0;
}




